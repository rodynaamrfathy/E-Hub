# =============================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# =============================================================================

# Environment Settings
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# API Keys - Replace with your actual keys
GOOGLE_API_KEY=your_google_gemini_api_key_here
GOOGLE_API_KEY_MM=your_google_gemini_multimodal_api_key_here
EXA_API_KEY=your_exa_api_key_here
LANGSMITH_API_KEY=your_langsmith_api_key_here

# Legacy API_KEY variable (maps to GOOGLE_API_KEY)
API_KEY=${GOOGLE_API_KEY}

# LangSmith Configuration
LANGSMITH_PROJECT=Dawar
LANGCHAIN_TRACING_V2=true

# Chatbot Configuration
CHATBOT_MODEL=gemini-2.5-pro
MAX_HISTORY=50

# Database Configuration
NEON_DATABASE_URL=postgresql://neondb_owner:password@endpoint.neon.tech/database_name?sslmode=require&channel_binding=require
DATABASE_URL=${NEON_DATABASE_URL}
DATABASE_URL_mcp_test=${NEON_DATABASE_URL}

# Database Performance Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Security Configuration (Development)
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Feature Flags
ENABLE_DOCS=true
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true