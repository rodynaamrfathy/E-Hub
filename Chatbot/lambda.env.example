# AWS Lambda Environment Variables Template
# Copy this file and configure your Lambda function with these variables

# Environment
ENVIRONMENT=production

# API Keys - Replace with your actual keys
GOOGLE_API_KEY=your_google_api_key_here
API_KEY=your_google_api_key_here
EXA_API_KEY=your_exa_api_key_here
LANGSMITH_API_KEY=your_langsmith_api_key_here

# LangSmith Configuration
LANGSMITH_PROJECT=Dawar
LANGCHAIN_TRACING_V2=true

# Chatbot Configuration
CHATBOT_MODEL=gemini-2.5-pro
MAX_HISTORY=50

# Database Configuration
# For Lambda, use connection pooling with RDS Proxy or Neon serverless Postgres
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require

# Security Configuration (Optional)
# ALLOWED_HOSTS=api.example.com,example.com
# CORS_ORIGINS=https://example.com,https://app.example.com

# Performance Configuration (Optional)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Logging
LOG_LEVEL=INFO

# Newsletter SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=your_email@gmail.com
FROM_NAME=E-Hub Newsletter
