# AWS Lambda Environment Variables Configuration
# These should be set in the Lambda function configuration

# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================

# Environment Settings
ENVIRONMENT=production
LOG_LEVEL=INFO

# API Keys (REQUIRED in production)
GOOGLE_API_KEY=your_google_gemini_api_key_here
GOOGLE_API_KEY_MM=your_google_gemini_multimodal_api_key_here
EXA_API_KEY=your_exa_api_key_here
LANGSMITH_API_KEY=your_langsmith_api_key_here

# Legacy API_KEY variable (maps to GOOGLE_API_KEY)
API_KEY=your_google_gemini_api_key_here

# LangSmith Configuration
LANGSMITH_PROJECT=Dawar
LANGCHAIN_TRACING_V2=true

# Chatbot Configuration
CHATBOT_MODEL=gemini-2.5-pro
MAX_HISTORY=50

# Database Configuration (REQUIRED in production)
NEON_DATABASE_URL=postgresql://neondb_owner:password@endpoint.neon.tech/database_name?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://neondb_owner:password@endpoint.neon.tech/database_name?sslmode=require&channel_binding=require
DATABASE_URL_mcp_test=postgresql://neondb_owner:password@endpoint.neon.tech/database_name?sslmode=require&channel_binding=require

# Database Performance Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Security Configuration
ALLOWED_HOSTS=your-api-gateway-domain.amazonaws.com,your-custom-domain.com
CORS_ORIGINS=https://your-frontend-domain.com,https://your-admin-domain.com

# =============================================================================
# AWS LAMBDA SPECIFIC SETTINGS
# =============================================================================

# Lambda Runtime Configuration
AWS_LAMBDA_EXEC_WRAPPER=/opt/bootstrap
_HANDLER=lambda_function.lambda_handler

# Lambda Performance Optimizations
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

# =============================================================================
# MONITORING AND OBSERVABILITY
# =============================================================================

# CloudWatch Logging
AWS_LAMBDA_LOG_GROUP_NAME=/aws/lambda/chatbot-backend
AWS_LAMBDA_LOG_STREAM_NAME=production

# X-Ray Tracing (optional)
# _X_AMZN_TRACE_ID=auto
# AWS_XRAY_TRACING_NAME=ChatbotAPI

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/disable features in production
ENABLE_DOCS=false
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true

# =============================================================================
# NOTES FOR DEPLOYMENT
# =============================================================================

# 1. Replace all placeholder values with actual production values
# 2. Set these as environment variables in your Lambda function configuration
# 3. Use AWS Secrets Manager for sensitive values in production
# 4. Enable CloudWatch monitoring and set up alarms
# 5. Configure API Gateway custom domain and SSL certificate
# 6. Set up proper IAM roles and policies for Lambda execution
